<% badge_class = case session.status
                 when "complete"               then "bg-success"
                 when "pending", "researching" then "bg-warning text-dark"
                 when "failed"                 then "bg-danger"
                 else                               "bg-secondary"
                 end %>
<span class="badge <%= badge_class %>"><%= session.status.humanize %></span>
